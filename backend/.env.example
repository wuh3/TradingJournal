# Copy this file to backend/.env and fill in real values. .env is gitignored.
#
# This file is read by the FastAPI app (via python-dotenv/pydantic-settings),
# NOT by docker compose -- so it's safe to put secrets containing "$" here
# (e.g. a bcrypt hash), unlike the root .env.

# --- Postgres (must match the root .env used by docker-compose) ---
POSTGRES_USER=tj_user
POSTGRES_PASSWORD=tj_password
POSTGRES_DB=trading_journal
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Auth ---
# Secret used to sign auth session tokens. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-hex-string

# The single-user login credentials for this app.
# Generate a bcrypt hash with: python scripts/hash_password.py "your-password-here"
# (run from the backend/ directory, with the venv active)
APP_USERNAME=mike
APP_PASSWORD_HASH='paste-the-bcrypt-hash-here-including-the-dollar-signs'

# Auth token lifetime (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=10080
