# Copy this file to .env and fill in real values. .env is gitignored.

# --- Postgres (used by docker-compose and the backend) ---
POSTGRES_USER=tj_user
POSTGRES_PASSWORD=tj_password
POSTGRES_DB=trading_journal
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Backend ---
# Secret used to sign auth session tokens. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-hex-string

# The single-user login credentials for this app.
# Generate a bcrypt hash with: python backend/scripts/hash_password.py "your-password-here"
APP_USERNAME=mike
APP_PASSWORD_HASH=

# Auth token lifetime (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=10080
