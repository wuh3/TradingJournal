# Copy this file to .env and fill in real values. .env is gitignored.
#
# This file is read ONLY by `docker compose` (for the Postgres container).
# Keep it to plain Postgres settings only — Docker Compose interpolates any
# "$" it finds in .env values against its own variable table, so anything
# containing "$" (like a bcrypt password hash) does NOT belong here. That
# secret lives in backend/.env instead (see backend/.env.example).

POSTGRES_USER=tj_user
POSTGRES_PASSWORD=tj_password
POSTGRES_DB=trading_journal
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
